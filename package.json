{
  "name": "mac-vibe-coder",
  "productName": "Mac Vibe Coder",
  "version": "1.0.11",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "description": "맥환경에서의 로컬 바이브코딩을 도와주기위한 프로젝트",
  "author": "HDomi",
  "repository": {
    "type": "git",
    "url": "https://github.com/HDomi/mac-vibe-coder.git"
  },
  "scripts": {
    "icons": "env -u ELECTRON_RUN_AS_NODE electron scripts/generate-icons.cjs",
    "dev": "concurrently -k -n web,server \"vite\" \"MVC_DEV=1 tsx watch server/index.ts\"",
    "dev:app": "npm run build:main && env -u ELECTRON_RUN_AS_NODE VITE_DEV=1 electron .",
    "build:main": "tsc -p tsconfig.json && cp electron/preload.cjs dist/electron/preload.cjs",
    "build:web": "vite build",
    "build": "npm run build:main && npm run build:web && node scripts/build-info.cjs",
    "dist": "npm run build && electron-builder --mac --arm64 --publish never",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "serve": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "LC_ALL=en_US.UTF-8 tsx --tsconfig web/tsconfig.json --test tests/*.test.ts tests/*.test.tsx",
    "test:ui": "env -u ELECTRON_RUN_AS_NODE electron tests/smoke-ui.cjs",
    "app": "env -u ELECTRON_RUN_AS_NODE electron .",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true; chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true; scripts/brand-electron.sh || true",
    "brand": "scripts/brand-electron.sh",
    "version:bump": "scripts/bump-version.sh",
    "check:lock": "scripts/check-lock.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "node-pty": "^1.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.4.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "concurrently": "^9.1.0",
    "cronstrue": "^3.38.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0",
    "material-icon-theme": "^5.39.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "smol-toml": "^1.9.1",
    "sql-formatter": "^15.9.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "uqr": "^0.1.3",
    "vite": "^6.3.0",
    "yaml": "^2.9.1"
  }
}
