{
  "name": "mac-vibe-coder",
  "productName": "Mac Vibe Coder",
  "version": "0.3.20",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "description": "맥환경에서의 로컬 바이브코딩을 도와주기위한 프로젝트",
  "scripts": {
    "icons": "env -u ELECTRON_RUN_AS_NODE electron scripts/generate-icons.cjs",
    "dev": "concurrently -k -n web,server \"vite\" \"MVC_DEV=1 tsx watch server/index.ts\"",
    "dev:app": "npm run build:main && env -u ELECTRON_RUN_AS_NODE VITE_DEV=1 electron .",
    "build:main": "tsc -p tsconfig.json && cp electron/preload.cjs dist/electron/preload.cjs",
    "build:web": "vite build",
    "build": "npm run build:main && npm run build:web && node scripts/build-info.cjs",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "serve": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "LC_ALL=en_US.UTF-8 tsx --tsconfig web/tsconfig.json --test tests/*.test.ts tests/*.test.tsx",
    "test:ui": "env -u ELECTRON_RUN_AS_NODE electron tests/smoke-ui.cjs",
    "app": "env -u ELECTRON_RUN_AS_NODE electron .",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true; scripts/brand-electron.sh || true",
    "brand": "scripts/brand-electron.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "node-pty": "^1.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.4.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.1.0",
    "electron": "^39.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
